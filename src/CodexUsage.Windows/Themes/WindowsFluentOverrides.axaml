<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WindowsPageHeaderBrush" Color="#F8F8F8" />
          <SolidColorBrush x:Key="WindowsCardBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="WindowsCardBorderBrush" Color="#D9D9D9" />
          <SolidColorBrush x:Key="WindowsControlBrush" Color="#FBFBFB" />
          <SolidColorBrush x:Key="WindowsControlHoverBrush" Color="#F0F0F0" />
          <SolidColorBrush x:Key="WindowsAccentBrush" Color="#005FB8" />
          <SolidColorBrush x:Key="WindowsAccentHoverBrush" Color="#004C99" />
          <SolidColorBrush x:Key="WindowsAccentForegroundBrush" Color="#FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WindowsPageHeaderBrush" Color="#202020" />
          <SolidColorBrush x:Key="WindowsCardBrush" Color="#2B2B2B" />
          <SolidColorBrush x:Key="WindowsCardBorderBrush" Color="#3F3F3F" />
          <SolidColorBrush x:Key="WindowsControlBrush" Color="#303030" />
          <SolidColorBrush x:Key="WindowsControlHoverBrush" Color="#3A3A3A" />
          <SolidColorBrush x:Key="WindowsAccentBrush" Color="#60CDFF" />
          <SolidColorBrush x:Key="WindowsAccentHoverBrush" Color="#8CDCFF" />
          <SolidColorBrush x:Key="WindowsAccentForegroundBrush" Color="#1A1A1A" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window.windows-surface">
    <Setter Property="FontFamily" Value="Segoe UI" />
  </Style>

  <Style Selector="Window.windows-surface TextBlock.usage-title">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Window.windows-surface TextBlock.usage-section">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Window.windows-surface TextBlock.usage-metric">
    <Setter Property="FontSize" Value="26" />
  </Style>

  <Style Selector="Window.windows-surface TextBlock.usage-caption">
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="Border.windows-page-header">
    <Setter Property="Background" Value="{DynamicResource WindowsPageHeaderBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WindowsCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="Border.windows-command-bar">
    <Setter Property="Background" Value="{DynamicResource WindowsPageHeaderBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WindowsCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <Style Selector="Window.windows-surface Border.usage-card">
    <Setter Property="Background" Value="{DynamicResource WindowsCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WindowsCardBorderBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style Selector="Window.windows-surface Button.usage-action">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource WindowsControlBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WindowsCardBorderBrush}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="Window.windows-surface Button.usage-action:pointerover">
    <Setter Property="Background" Value="{DynamicResource WindowsControlHoverBrush}" />
  </Style>

  <Style Selector="Window.windows-surface Button.windows-primary">
    <Setter Property="Background" Value="{DynamicResource WindowsAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WindowsAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource WindowsAccentForegroundBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Window.windows-surface Button.windows-primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource WindowsAccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WindowsAccentHoverBrush}" />
  </Style>

  <Style Selector="Window.windows-surface Border.usage-card Border">
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style Selector="Window.windows-details TabControl">
    <Setter Property="Margin" Value="16,8,16,12" />
  </Style>

  <Style Selector="Window.windows-details StackPanel.usage-details-content">
    <Setter Property="Margin" Value="0,14,0,0" />
  </Style>

  <Style Selector="Window.windows-details TabItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
</Styles>
