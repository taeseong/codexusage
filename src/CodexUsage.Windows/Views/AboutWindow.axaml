<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodexUsage.Windows.Views.AboutWindow"
        x:CompileBindings="False"
        Title="About CodexUsage"
        Icon="avares://CodexUsage/Assets/codex-usage.ico"
        Width="320"
        Height="440"
        MinWidth="320"
        MinHeight="400"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource UsageSurfaceAppBrush}"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Button.github-link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Foreground" Value="{DynamicResource UsageSuccessBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>
  <ScrollViewer Margin="28,24"
                VerticalScrollBarVisibility="Auto">
    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">
      <Border Width="58"
              Height="58"
              HorizontalAlignment="Center"
              CornerRadius="12"
              Background="{DynamicResource UsageTextPrimaryBrush}">
        <TextBlock HorizontalAlignment="Left"
                   Margin="11,0,0,0"
                   VerticalAlignment="Center"
                   FontFamily="Cascadia Mono,Consolas"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{DynamicResource UsageSurfaceAppBrush}"
                   Text="&gt;_" />
      </Border>
      <TextBlock Classes="usage-title"
                 HorizontalAlignment="Center"
                 FontSize="19"
                 Text="CodexUsage" />
      <TextBlock Classes="usage-caption"
                 HorizontalAlignment="Center"
                 Text="{Binding Version, StringFormat=Version {0}}" />
      <TextBlock Classes="usage-caption"
                 HorizontalAlignment="Center"
                 Text="{Binding Revision, StringFormat=Build {0}}" />
      <TextBlock x:Name="CliStatusText"
                 Classes="usage-caption"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 Text="CLI: Checking..." />
      <Button Classes="github-link"
              HorizontalAlignment="Center"
              Click="OnOpenGitHub"
              Content="github.com/taeseong/codexusage" />
      <Button x:Name="CopyDiagnosticsButton"
              AutomationProperties.Name="Copy sanitized diagnostics"
              Classes="usage-action"
              HorizontalAlignment="Center"
              Click="OnCopyDiagnostics"
              Content="Copy diagnostics" />
      <Button x:Name="CheckForUpdatesButton"
              AutomationProperties.Name="Check for CodexUsage updates"
              Classes="usage-action"
              HorizontalAlignment="Center"
              Click="OnCheckForUpdates"
              Content="Check for updates" />
      <Button x:Name="OpenReleaseButton"
              AutomationProperties.Name="Open latest CodexUsage release"
              Classes="github-link"
              HorizontalAlignment="Center"
              Click="OnOpenLatestRelease"
              IsVisible="False"
              Content="Open release" />
      <TextBlock x:Name="DiagnosticsStatusText"
                 Classes="usage-caption"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</Window>
