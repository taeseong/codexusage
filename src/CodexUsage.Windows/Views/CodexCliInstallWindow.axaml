<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodexUsage.Windows.Views.CodexCliInstallWindow"
        Title="Codex CLI 설치 필요"
        Icon="avares://CodexUsage/Assets/codex-usage.ico"
        Width="480"
        Height="500"
        MinWidth="440"
        MinHeight="460"
        CanResize="False"
        Background="{DynamicResource UsageSurfaceAppBrush}"
        WindowStartupLocation="Manual">
  <Grid Margin="{StaticResource UsagePaddingPage}"
        RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
        RowSpacing="{StaticResource UsageSpace4}">
    <Grid ColumnDefinitions="38,*"
          ColumnSpacing="{StaticResource UsageSpace3}">
      <Border Width="38"
              Height="38"
              CornerRadius="{StaticResource UsageRadiusSmall}"
              Background="{DynamicResource UsageTextPrimaryBrush}">
        <TextBlock HorizontalAlignment="Left"
                   Margin="7,0,0,0"
                   VerticalAlignment="Center"
                   FontFamily="Cascadia Mono,Consolas"
                   FontSize="15"
                   FontWeight="Bold"
                   Foreground="{DynamicResource UsageSurfaceAppBrush}"
                   Text="&gt;_" />
      </Border>
      <StackPanel Grid.Column="1"
                  Spacing="{StaticResource UsageSpace1}">
        <TextBlock Classes="usage-title"
                   FontSize="20"
                   Text="Codex CLI가 필요합니다" />
        <TextBlock Classes="usage-caption"
                   Text="CodexUsage가 이 컴퓨터에서 Codex CLI를 찾지 못했습니다." />
      </StackPanel>
    </Grid>

    <TextBlock Grid.Row="1"
               Classes="usage-body"
               TextWrapping="Wrap"
               Text="PowerShell standalone 설치를 권장합니다. Node.js 없이 설치할 수 있습니다." />

    <Border Grid.Row="2"
            Classes="usage-card"
            Padding="14,12">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="{StaticResource UsageSpace3}">
        <TextBlock VerticalAlignment="Center"
                   FontFamily="Cascadia Mono,Consolas"
                   FontSize="12"
                   Text="irm https://chatgpt.com/codex/install.ps1 | iex" />
        <Button Grid.Column="1"
                Classes="usage-action"
                MinHeight="36"
                Padding="12,6"
                Click="OnCopyPowerShellInstallCommand"
                Content="명령 복사" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="3"
                Spacing="{StaticResource UsageSpace1}">
      <TextBlock Classes="usage-caption"
                 Text="Node.js/npm을 이미 사용 중이면 다음 방식도 사용할 수 있습니다." />
      <Border Classes="usage-card"
              Padding="14,10">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="{StaticResource UsageSpace3}">
          <TextBlock VerticalAlignment="Center"
                     FontFamily="Cascadia Mono,Consolas"
                     FontSize="12"
                     Text="npm install --global @openai/codex" />
          <Button Grid.Column="1"
                  Classes="usage-action"
                  MinHeight="32"
                  Padding="12,5"
                  Click="OnCopyNpmInstallCommand"
                  Content="npm 복사" />
        </Grid>
      </Border>
    </StackPanel>

    <StackPanel Grid.Row="4"
                Spacing="{StaticResource UsageSpace2}">
      <TextBlock Classes="usage-section"
                 FontSize="15"
                 Text="설치 후" />
      <TextBlock Classes="usage-body"
                 TextWrapping="Wrap"
                 Text="1. Codex 로그인이 필요하면 로그인 절차를 완료합니다." />
      <TextBlock Classes="usage-body"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap"
                 Text="2. 아래 다시 확인 버튼을 누르면 앱을 재시작하지 않고 확인합니다." />
      <TextBlock x:Name="ActionStatusText"
                 Classes="usage-caption"
                 TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="5"
          ColumnDefinitions="*,Auto,Auto"
          ColumnSpacing="{StaticResource UsageSpace2}">
      <TextBlock Classes="usage-caption"
                 VerticalAlignment="Center"
                 Text="설치 후 Codex 로그인을 완료해 주세요." />
      <Button Grid.Column="1"
              x:Name="RetryButton"
              AutomationProperties.Name="Retry Codex CLI detection"
              Classes="usage-action"
              MinWidth="96"
              Click="OnRetry"
              Content="다시 확인" />
      <Button Grid.Column="2"
              Classes="usage-action"
              MinWidth="88"
              Click="OnClose"
              Content="닫기" />
    </Grid>
  </Grid>
</Window>
